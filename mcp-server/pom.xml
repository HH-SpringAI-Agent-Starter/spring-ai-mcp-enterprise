<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>spring-ai-mcp-enterprise</artifactId>
        <groupId>com.mcp.enterprise</groupId>
        <version>1.1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>mcp-server</artifactId>
    <packaging>jar</packaging>
    <description>MCP Server Application - Entry + REST API + Admin UI</description>

    <dependencies>
        <dependency>
            <groupId>com.mcp.enterprise</groupId>
            <artifactId>mcp-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mcp.enterprise</groupId>
            <artifactId>mcp-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- V1.6: 接入 mcp-monitor（指标/审计/告警端点，默认自动启用） -->
        <dependency>
            <groupId>com.mcp.enterprise</groupId>
            <artifactId>mcp-monitor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mcp.enterprise</groupId>
            <artifactId>mcp-tool-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- V1.11: 多租户 Row-level 隔离（默认启用 fail-closed，X-Tenant-Id 头注入） -->
        <dependency>
            <groupId>com.mcp.enterprise</groupId>
            <artifactId>mcp-tenant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
