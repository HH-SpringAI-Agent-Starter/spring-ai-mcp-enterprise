<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>spring-ai-mcp-enterprise</artifactId>
        <groupId>com.mcp.enterprise</groupId>
        <version>1.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>mcp-springai-tools</artifactId>
    <packaging>jar</packaging>
    <description>Spring AI Tool Bridge - 把 Spring AI @Tool / ToolCallback 自动注册为企业级 MCP 工具（自动继承 RBAC/限流/审计/Scope）</description>

    <dependencies>
        <!-- 内部核心模块依赖：ToolRegistry / McpToolManager / ToolDefinition -->
        <dependency>
            <groupId>com.mcp.enterprise</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring AI Core（@Tool / ToolCallback / ToolCallbacks / ToolDefinition），版本由父 pom 的 spring-ai-bom 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-core</artifactId>
        </dependency>

        <!-- Spring Boot Autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- JSON Schema 解析（由 Spring Boot 父 pom 管理版本） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
